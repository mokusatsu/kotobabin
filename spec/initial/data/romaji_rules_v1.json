  "tagDescriptions": {
    "n": "読み内の「ん」の出現",
    "sokuon": "読み内の「っ」の出現",
    "yoon": "tables.yoonにある基本拗音ペアの出現",
    "long_mark": "読み内の長音記号「ー」の入力を対象とし、音声学上の長さを表さない。",
    "foreign": "tables.foreignにある外来音ペアの出現"
  },
  "canonicalLengthDefinition": "読み位置を節点とする全受理辺のDAGで、末端までの最短ASCII打鍵数を求める。",
  "guideDefinition": "ガイドは受理経路の一例。語のデータに単一の正解ローマ字列を保存しない。"
