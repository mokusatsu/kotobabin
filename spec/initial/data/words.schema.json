  "$defs": {
    "wordId": {
      "type": "string",
      "pattern": "^(daily|food|living|town|nature|people)_[rsc][0-9]{2}$(?![\\s\\S])"
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display",
        "reading",
        "courseId",
        "topicId",
        "dictionarySetId",
        "difficultyBand",
        "tags",
        "canonicalLength",
        "reviewed",
        "complexityScore"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/wordId"
        },
        "display": {
          "type": "string",
          "minLength": 1,
          "maxLength": 18,
          "pattern": "^[^\\s0-9０-９、。,.!?！？]+$(?![\\s\\S])"
        },
        "reading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[ぁあぃいぅうぇえぉおかがきぎくぐけげこごさざしじすずせぜそぞただちぢっつづてでとどなにぬねのはばぱひびぴふぶぷへべぺほぼぽまみむめもゃやゅゆょよらりるれろわをんゔー]+$(?![\\s\\S])",
          "description": "受理表のひらがなと長音記号。ゔを含み、ゐ・ゑ・小さいゎなどを含まない。"
        },
        "courseId": {
          "type": "string",
          "enum": [
            "relaxed",
            "standard",
            "challenge"
          ]
        },
        "topicId": {
          "type": "string",
          "enum": [
            "daily",
            "food",
            "living",
            "town",
            "nature",
            "people"
          ]
        },
        "dictionarySetId": {
          "type": "string",
          "const": "kotobabin-ja-960-v2"
        },
        "difficultyBand": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ],
          "description": "コース内の複雑度順による相対的な編集基準。実測難度ではない。"
        },
        "tags": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "n",
              "sokuon",
              "yoon",
              "long_mark",
              "foreign"
            ]
          },
          "description": "n、sokuon、yoon、long_mark、foreignの順に、読みから自動導出する。"
        },
        "canonicalLength": {
          "type": "integer",
          "minimum": 3,
          "maximum": 24,
          "description": "全受理経路に対する最短打鍵数。"
        },
        "reviewed": {
          "type": "boolean",
          "const": true,
          "description": "作成時の表記と読みの校正済み。独立レビュー完了や実機検証済みを意味しない。"
        },
        "editorialNote": {
          "type": "string",
          "maxLength": 200
        },
        "complexityScore": {
          "type": "integer",
          "minimum": 0,
          "description": "L+n数+2×っ数+2×基本拗音ペア数+2×外来音ペア数+ー数。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "courseId": {
                "const": "relaxed"
              }
            },
            "required": [
              "courseId"
            ]
          },
          "then": {
            "properties": {
              "canonicalLength": {
                "minimum": 3,
                "maximum": 8
              },
              "id": {
                "pattern": "^[a-z]+_r[0-9]{2}$(?![\\s\\S])"
              },
              "tags": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "courseId": {
                "const": "standard"
              }
            },
            "required": [
              "courseId"
            ]
          },
          "then": {
            "properties": {
              "canonicalLength": {
                "minimum": 5,
                "maximum": 14
              },
              "id": {
                "pattern": "^[a-z]+_s[0-9]{2}$(?![\\s\\S])"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "courseId": {
                "const": "challenge"
              }
            },
            "required": [
              "courseId"
            ]
          },
          "then": {
            "properties": {
              "canonicalLength": {
                "minimum": 10,
                "maximum": 24
              },
              "id": {
                "pattern": "^[a-z]+_c[0-9]{2}$(?![\\s\\S])"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topicId": {
                "const": "daily"
              }
            },
            "required": [
              "topicId"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^daily_"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topicId": {
                "const": "food"
              }
            },
            "required": [
              "topicId"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^food_"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topicId": {
                "const": "living"
              }
            },
            "required": [
              "topicId"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^living_"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topicId": {
                "const": "town"
              }
            },
            "required": [
              "topicId"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^town_"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topicId": {
                "const": "nature"
              }
            },
            "required": [
              "topicId"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^nature_"
              }
            }
          }
